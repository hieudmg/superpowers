#!/usr/bin/env bash
# Resolve the git-ignored SDD scratch directory for one plan. The directory
# holds controller-owned ledgers, task briefs, and review packages. Worker and
# reviewer reports belong in Pi-managed output artifacts, not this checkout.
#
# Workspace identity is the sanitized plan basename plus the first 12 hex
# digits of SHA-256(normalized absolute plan path). The hash prevents distinct
# plans named task.md from sharing recovery state.
#
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

plan_dir=$(cd -P "$(dirname "$plan")" && pwd)
plan_path="$plan_dir/$(basename "$plan")"
slug=$(basename "$plan_path" .md | tr -cs '[:alnum:]._' '-' | sed 's/^-*//; s/-*$//')
[ -n "$slug" ] || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

if command -v sha256sum >/dev/null 2>&1; then
  path_hash=$(printf '%s' "$plan_path" | sha256sum | awk '{print substr($1, 1, 12)}')
elif command -v shasum >/dev/null 2>&1; then
  path_hash=$(printf '%s' "$plan_path" | shasum -a 256 | awk '{print substr($1, 1, 12)}')
else
  echo "sdd-workspace requires sha256sum or shasum" >&2
  exit 2
fi

root=$(git rev-parse --show-toplevel)
base="$root/.superpowers/sdd"
dir="$base/$slug-$path_hash"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd

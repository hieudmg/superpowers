#!/usr/bin/env bash
# Generate a controller-owned review package containing the committed range and
# current working-tree changes. Including the latter lets a fresh reviewer
# inspect a task when commits are not authorized. The controller must start a
# task with a clean checkout or explicitly account for pre-existing changes.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: the plan-specific SDD workspace, named by review range.
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

write_diff() {
  git diff --binary --full-index "$@" || {
    status=$?
    [ "$status" -eq 1 ] || return "$status"
  }
}

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Committed changes"
  echo
  echo "### Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "### Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "### Diff"
  write_diff "${base}..${head}"
  echo
  echo "## Working tree changes"
  echo
  echo "### Staged diff"
  write_diff --cached
  echo
  echo "### Unstaged diff"
  write_diff
  echo
  echo "### Untracked diff"
  while IFS= read -r -d '' path; do
    write_diff --no-index /dev/null "$path"
  done < <(git ls-files --others --exclude-standard -z)
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
